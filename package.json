{
  "name": "aero-design-system",
  "version": "0.1.0",
  "description": "The AeroCompetence Hub design system: Tailwind v4 tokens, plain CSS tokens, the React UI kit and its lint rules.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouuzi/aero-design-system.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/components/styles.d.ts",
      "default": "./dist/components/styles.js"
    },
    "./theme.css": "./theme.css",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./eslint": "./eslint/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "tokens.css",
    "tokens.json",
    "eslint/index.mjs",
    "eslint/plugin.mjs",
    "scripts/vendor.mjs",
    "README.md",
    "CHANGELOG.md",
    "MIGRATING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "tokens": "node scripts/tokens.mjs",
    "check:tokens": "node scripts/tokens.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node scripts/tokens.mjs --check && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "guide:build": "node scripts/design-system/build.mjs",
    "guide:check": "node scripts/design-system/build.mjs --check",
    "guide:previews": "node scripts/design-system/check-previews.cjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-tooltip": "1.2.7",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^0.553.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.10",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "engines": {
    "node": ">=20"
  }
}
